# Required: generate a secret with `uv run python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Never commit your populated .env; keep this key stable across restarts.
CLIPDOCK_SIGNING_KEY=
CLIPDOCK_DATA_DIR=./data
# Defaults: 2 concurrent jobs; 8 total queued/processing; 64 MiB download cap;
# 1 GiB aggregate data budget; inspection token 10 min; jobs/files 1 hour.
# Limits are Settings fields in clipdock/api.py (not arbitrary yt-dlp arguments).
