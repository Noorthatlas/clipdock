# Render Free / 512 MiB single process. Set secrets in the provider UI.
CLIPDOCK_SIGNING_KEY=
CLIPDOCK_DATA_DIR=/app/data
CLIPDOCK_CONCURRENCY=1
CLIPDOCK_QUEUE_CAP=3
CLIPDOCK_MAX_DURATION_SECONDS=120
CLIPDOCK_MAX_FILE_BYTES=16777216
CLIPDOCK_DISK_BUDGET_BYTES=134217728
CLIPDOCK_TIMEOUT_SECONDS=60
CLIPDOCK_JOB_TTL_SECONDS=1800
CLIPDOCK_TOKEN_TTL_SECONDS=600
# Render supplies PORT; Docker's command uses ${PORT:-8000}.
# Ephemeral filesystem: jobs, files and capabilities disappear on replacement.
